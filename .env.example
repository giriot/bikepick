# ═══════════════════════════════════════════════════════════════════════
# Bikepick.IN — environment template
# Copy to .env.local for local dev. On Vercel, set these in
# Project → Settings → Environment Variables (all environments).
# NEVER commit real values. .gitignore excludes .env* files.
# ═══════════════════════════════════════════════════════════════════════

# ── REQUIRED (production) ───────────────────────────────────────────────
# Supabase Postgres connection string (Project Settings → Database →
# Connection string → "Session pooler (Supavisor)", port 5432, user postgres).
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Long random string (e.g. `openssl rand -hex 32`) — signs session cookies.
AUTH_SECRET=

# ── OPTIONAL: Supabase compat layer (safe no-op when unset) ────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://bikepick.in

# ── OPTIONAL integrations ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_API_URL=
EMAIL_API_KEY=
# Or Outlook SMTP (takes priority over the generic HTTP provider).
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=bikepick@outlook.com
MAIL_FROM=bikepick@outlook.com
# Outlook.com SMTP now requires Modern Auth / OAuth2 for SMTP AUTH.
# Register an Entra app with the delegated https://outlook.office.com/SMTP.Send
# scope, then store these three values as private deployment secrets.
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_OAUTH_ACCESS_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
# Legacy password/app-password fallback for providers that still support it.
SMTP_PASS=
SMS_API_URL=
SMS_API_KEY=
CRON_SECRET=
ADSENSE_CLIENT_ID=

# ── LOCAL DEV only (used when DATABASE_URL is unset) ───────────────────
# SQLITE_PATH=./data/bikepick.db
