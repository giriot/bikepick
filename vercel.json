{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/expire-offers",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/expire-listings",
      "schedule": "40 1 * * *"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "50 1 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}